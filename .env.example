# Copy this to .env on the server and fill in the values
# Never commit .env to git

# A long random string for signing session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# ClickHouse credentials — must match docker-compose.yml environment.
# The container regenerates /etc/clickhouse-server/users.d/default-user.xml
# from this value on every start, so changing it here and recreating both
# services is all a rotation takes. Generate with: openssl rand -hex 24
CLICKHOUSE_PASSWORD=change_this_to_a_strong_password

# ── PostgreSQL (source of truth since the cutover) ───────────────────────────
# The app's data lives in database `procurement` on the shared mmi-postgres
# container (which also hosts other projects' databases — never point these
# at anything else). Roles are created by db/postgres_setup.sql; see
# RUNBOOK_POSTGRES_CUTOVER.md.

# Docker network mmi-postgres is attached to. docker-compose.yml joins `app`
# and `clickhouse` to it as an external network. Find it with:
#   docker inspect mmi-postgres -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
MMI_PG_NETWORK=change_this_to_the_mmi_postgres_network

# Password of procurement_app, the app's login (read/write on the procurement
# tables, no DDL). Becomes PGPASSWORD inside the app container.
# Hex only, so it never needs quoting. Generate with: openssl rand -hex 24
# Rotating: change it here, re-run db/postgres_setup.sql with the new value,
# then `docker compose up -d app`.
PG_APP_PASSWORD=change_this_to_a_strong_password

# Password of procurement_ro, the SELECT-only login ClickHouse uses to pull
# from Postgres for the warehouse (scripts/ch_sync.sh). Read inside the
# clickhouse container by db/clickhouse-config.d/30-pg-source.xml.
# Generate with: openssl rand -hex 24
# Rotating: change it here, re-run db/postgres_setup.sql with the new value,
# then `docker compose up -d clickhouse`.
PG_RO_PASSWORD=change_this_to_a_strong_password

# ── Hauling mirror (optional; RUNBOOK_HAULING_MIRROR.md) ─────────────────────
# Password of hauling_ro, the SELECT-only login ClickHouse uses to copy a few
# tables from the hauling_tracker database (another team's live system on the
# same mmi-postgres) into the ClickHouse database `hauling`
# (scripts/hauling_sync.sh). Read inside the clickhouse container by
# db/clickhouse-config.d/40-pg-hauling.xml. Leaving it unset is safe: the
# procurement app and its sync do not use it, only the hauling sync fails.
# Hex only, so it never needs quoting. Generate with: openssl rand -hex 24
# Rotating: change it here, re-run the db/hauling_ro_setup.sql step of the
# runbook (it sets the new password on the role), then
# `docker compose up -d --force-recreate clickhouse` (a ~5 s warehouse blip).
HAULING_RO_PASSWORD=change_this_to_a_strong_password

# ── Minimart mirror (optional; RUNBOOK_MINIMART_MIRROR.md) ───────────────────
# Password of minimart_ro, the SELECT-only login ClickHouse uses to copy the
# Postgres database `minimart` (on the same mmi-postgres) into the ClickHouse
# database `minimart` (scripts/minimart_sync.sh). The role itself is created by
# db/minimart_setup.sql (RUNBOOK_MINIMART_MIGRATION.md), column-level grants that
# keep secret columns out come from db/minimart_ro_grants.sql. Read inside the
# clickhouse container by db/clickhouse-config.d/50-pg-minimart.xml. Leaving it
# unset is safe: the procurement app and the other syncs do not use it, only the
# minimart sync fails. At least 16 characters; hex only, so it never needs quoting.
# Generate with: openssl rand -hex 24
# Rotating: change it here, re-run db/minimart_setup.sql with the new value (the
# role's password), then `docker compose up -d --force-recreate clickhouse`.
MINIMART_RO_PASSWORD=change_this_to_a_strong_password

# create_user.js reads these. It is a one-time script, so pass them inline for
# the single run rather than leaving a login sitting in this file:
#   NEW_USER_NAME=purchasing3 NEW_USER_PASSWORD='...' node create_user.js
# NEW_USER_NAME defaults to purchasing2, NEW_USER_ROLE to purchasing and
# NEW_USER_FULLNAME to "Purchasing 2". NEW_USER_PASSWORD has no default and
# the script exits without it.
